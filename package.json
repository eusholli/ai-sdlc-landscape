{
  "name": "ai-sdlc-landscape",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm data && next dev --turbopack",
    "build": "pnpm data && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm data && vitest run",
    "check": "pnpm data && tsc --noEmit && eslint && vitest run",
    "data": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/build-data.ts --check",
    "data:links": "NODE_OPTIONS=--max-http-header-size=65536 tsx scripts/check-links.ts",
    "scan": "NODE_OPTIONS=--max-http-header-size=65536 tsx scripts/scan.ts",
    "logos": "NODE_OPTIONS=--max-http-header-size=65536 tsx scripts/fetch-logos.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-force-graph-2d": "^1.29.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "swr": "^2.3.6",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "v0-sdk": "^0.16.7",
    "vitest": "^5.0.5",
    "yaml": "2.8.1"
  }
}
