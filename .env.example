# Copy to .env.local (gitignored). Every value is optional for building the site.

# Serper search API key (serper.dev), used only by `pnpm scan`. Without it the scan prints its
# queries for running by hand. The free plan works: it caps quoted queries at ten results, and the
# scan falls back to ten.
SERPER_API_KEY=

# Public URL of the deployed site, used for canonical URLs, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://aisdlclandscape.org

# Plausible's site-specific script URL (https://plausible.io/js/pa-<hash>.js), from the Plausible
# dashboard: site settings, Site installation. Set it in Vercel's Production environment only, so
# local and preview builds send no analytics. Without it, no analytics script loads.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
