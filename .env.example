# Copy to .env.local (gitignored). Every value is optional for building the site.

# v0 Platform API key, used only by scripts/v0-run.ts. Create it at v0.app under Settings, API keys.
V0_API_KEY=

# Public URL of the deployed site, used for canonical URLs, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://ai-sdlc-landscape.vercel.app
